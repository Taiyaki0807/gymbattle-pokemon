{
  "name": "gymbattle-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/domain.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-gymbattle --only firestore,auth \"node --test --test-concurrency=1 tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-gymbattle --only firestore,auth",
    "board-id": "node -e \"console.log(require('node:crypto').randomBytes(24).toString('hex'))\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.34.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
